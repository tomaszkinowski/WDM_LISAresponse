# Byte-compiled / optimized / DLL files
__pycache__/

# Sphinx build
docs/build/

# Packaging metadata
*.egg-info/

# JAX compilation cache (if using)
jax-cache/
*.jaxlib

# Virtual environments
.venv/
env/
venv/
ENV/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# pytest
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# VS Code settings
.vscode/

# macOS
.DS_Store

# large data files
data/*.txt
data/*.h5

#keeps local save files
_local_wdm_*
dense_runtime_*
examples/exact_shift_results/

# Figures. Notebooks write plots beside themselves and none of them belong in
# the history; the logo is the one tracked image. On this branch the paper
# figures in plotting/figures/, plotting/figures/appendix/ and
# plotting/figures/investigations/ are the exception (see the !-rules below).
*.png
*.pdf
*.svg
!logo_images/*.png
!plotting/figures/*.pdf
!plotting/figures/*.png
!plotting/figures/appendix/*.pdf
!plotting/figures/appendix/*.png
!plotting/figures/investigations/*.pdf
!plotting/figures/investigations/*.png

# Numerical caches. The plotting scripts recompute any that are missing; the
# full-year series behind figures 9 and 11 run to hundreds of MB each.
*.npz
